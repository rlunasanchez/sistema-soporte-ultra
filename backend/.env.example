# ==========================================
# SISTEMA DE SOPORTE ULTRA - CONFIGURACIÓN
# ==========================================
# Este proyecto usa MySQL en local y PostgreSQL en producción (Vercel).
# El sistema detecta automáticamente cuál usar según las variables.

# ==========================================
# ENTORNO
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# BASE DE DATOS LOCAL (MySQL)
# Se usa automáticamente cuando NO está definida DATABASE_URL
# ==========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=6498
DB_NAME=soporte_ultra_db

# ==========================================
# BASE DE DATOS PRODUCCIÓN (PostgreSQL en Vercel/Neon)
# Se usa automáticamente cuando está definida DATABASE_URL
# Descomentar y configurar SOLO en producción
# ==========================================
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# ==========================================
# AUTENTICACIÓN JWT
# ==========================================
JWT_SECRET=clave_secreta

# ==========================================
# EMAIL (para recuperación de contraseña)
# ==========================================
EMAIL_USER=rodrigo.luna.analista@gmail.com
EMAIL_PASS=bajeyijjqtebzfeo
